# Copier en .env pour le développement local (voir infra/docker-compose.yml
# pour lancer une base PostgreSQL locale).

DATABASE_URL="postgresql://coco:coco@localhost:5432/coco_dev"

# Générer une valeur forte, ex. `openssl rand -base64 48`.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN_SECONDS=900

PORT=3001
APP_WEB_ORIGIN="http://localhost:3000"
APP_ADMIN_ORIGIN="http://localhost:3002"

# Connexion Google (§5.3 CDC) — laisser vide pour désactiver ces routes en dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
